# Copy this file to .env and fill in real values. .env is gitignored.

# OAuth Client ID from Google Cloud Console (Credentials > OAuth client ID > Web application).
GOOGLE_CLIENT_ID=

# Comma- or semicolon-separated list of Google account emails allowed to
# sign in. Use semicolons if setting this via a GitHub Actions secret for
# Cloud Run deploy - gcloud's env-vars flag splits on commas itself, so a
# comma-separated value gets mangled when passed through that path.
AUTHORIZED_EMAILS=you@gmail.com

# Optional friendly names for the in-app user switcher, one per authorized
# email, "email=Name" pairs separated by semicolons (same delimiter reason
# as AUTHORIZED_EMAILS above). Falls back to a guess from the email's local
# part when not set.
DISPLAY_NAMES=you@gmail.com=Your Name

# Random secret used to sign the session cookie. Generate with: openssl rand -hex 32
SESSION_SECRET=

# Set to false only for local http://localhost testing (cookies otherwise require HTTPS).
COOKIE_SECURE=true
